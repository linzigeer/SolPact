# SolPact defaults to the deployed Solana Devnet escrow program.
NEXT_PUBLIC_ENABLE_LEGACY_DEMO=false

# Optional overrides must match the deployed program and Solana Devnet.
NEXT_PUBLIC_SOLANA_PROGRAM_ID=8yTJg2ze6mPunXu8fgX6DBVwg6kxpLixM2e9DPhcQ5bt
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional server-only Devnet RPC URL; keep provider API keys here.
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional historical EVM demo; used only when the flag above is true.
NEXT_PUBLIC_WC_PROJECT_ID=demo_replace_with_walletconnect_cloud_id
NEXT_PUBLIC_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
